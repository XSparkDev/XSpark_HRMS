        {
          "name": "3. Get Employee by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "employees", "{{employee_id}}"]
            },
            "description": "Get specific employee by ID."
          },
          "response": []
        },
        {
          "name": "4. Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+27123456790\",\n  \"address\": \"456 Updated Street, Cape Town\",\n  \"employment_status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "employees", "{{employee_id}}"]
            },
            "description": "Update employee information."
          },
          "response": []
        },
        {
          "name": "5. Create Foreign Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"David\",\n  \"last_name\": \"Williams\",\n  \"email\": \"david.williams@xspark.com\",\n  \"dob\": \"1988-11-08\",\n  \"sex\": \"male\",\n  \"nationality\": \"United Kingdom\",\n  \"passport_number\": \"GB123456789\",\n  \"passport_document_url\": \"https://example.com/passport.pdf\",\n  \"work_permit_url\": \"https://example.com/workpermit.pdf\",\n  \"date_hired\": \"2023-03-10\",\n  \"employment_status\": \"probation\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            },
            "description": "Create foreign national employee with passport number."
          },
          "response": []
        }
      ],
      "description": "Employee CRUD operations."
    },
    {

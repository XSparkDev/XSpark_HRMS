              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Smith\",\n  \"email\": \"john.smith@xspark.com\",\n  \"dob\": \"1985-03-15\",\n  \"sex\": \"male\",\n  \"nationality\": \"South Africa\",\n  \"id_number\": \"8503151234567\",\n  \"date_hired\": \"2023-01-15\",\n  \"phone\": \"+27123456789\",\n  \"address\": \"123 Main Street, Cape Town\",\n  \"employment_status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
